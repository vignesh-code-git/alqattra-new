# ==========================================
# Backend Environment Variables (Render)
# ==========================================
DEBUG=false
SECRET_KEY=generate_a_secure_random_key_here
DJANGO_SETTINGS_MODULE=config.settings.production

# PostgreSQL Database (Render Managed PostgreSQL, Supabase, Neon, etc.)
# If you have a full connection string:
DATABASE_URL=postgresql://alqattara:alqattara123@your-db-host:5432/alqattara_db
DB_SSL_REQUIRE=true

# Or individual DB credentials:
DB_NAME=alqattara_db
DB_USER=alqattara
DB_PASSWORD=alqattara123
DB_HOST=localhost
DB_PORT=5432

# CORS & Host Domains (Add your Vercel frontend domain here)
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com
