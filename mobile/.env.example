# Where the app finds the AlQattara CRM backend - the same Django server the
# CRM website (frontend) uses via its NEXT_PUBLIC_API_URL.
#
# Leave unset in development: the app reuses the Expo bundler's address,
# which is your PC, where Django runs.
#
# Set it for builds and for anything other than local development. Do not add
# "/api" - the app adds it.
#
# Local network (phone on the same Wi-Fi, Django started on 0.0.0.0:8000):
# EXPO_PUBLIC_API_URL=http://192.168.1.19:8000
#
# Deployed backend (once alqattara-crm-backend is live on Render):
# EXPO_PUBLIC_API_URL=https://alqattara-crm-backend.onrender.com
